{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganeshmallaya.github.io/common-crypto-api-caap/schemas/algorithm-profile.schema.json",
  "title": "CAAP experimental algorithm profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profileId", "profileVersion", "status", "family", "operations", "input", "output", "algorithms", "keyRequirements", "securityNotes", "references"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "0.2.0-draft"},
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
    "profileVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["experimental", "candidate", "withdrawn"]},
    "family": {"enum": ["signature", "mac", "encryption", "digest", "random", "establishment", "key"]},
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{2,63}$"}},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation", "encoding", "emptyAllowed"],
      "properties": {
        "interpretation": {"type": "string"},
        "encoding": {"type": "string"},
        "emptyAllowed": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "encoding"],
      "properties": {"type": {"type": "string"}, "encoding": {"type": "string"}}
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "status", "references"],
        "properties": {
          "identifier": {"type": "string", "format": "uri"},
          "status": {"enum": ["implemented", "specified", "disabled"]},
          "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
        }
      }
    },
    "keyRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "privateMaterialReturned", "opaqueReference", "states"],
      "properties": {
        "purpose": {"type": "string"},
        "privateMaterialReturned": {"const": false},
        "opaqueReference": {"const": true},
        "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "securityNotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
  }
}
