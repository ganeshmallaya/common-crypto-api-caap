{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganeshmallaya.github.io/common-crypto-api-caap/schemas/policy-profile.schema.json",
  "title": "CAAP experimental policy profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "profileVersion", "status", "effectiveAt", "rules"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "0.2.0-draft"},
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
    "profileVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["draft", "active", "retired", "withdrawn"]},
    "effectiveAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": ["string", "null"], "format": "date-time"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "intent", "operations", "decision"],
        "properties": {
          "ruleId": {"type": "string"},
          "intent": {"const": "artifact-signing"},
          "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ResolvePolicy", "CreateKey", "Sign", "Verify"]}},
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "algorithm", "allowedProviderClasses"],
            "properties": {
              "profile": {"const": "artifact-signing-v0"},
              "algorithm": {"const": "http://www.w3.org/2021/04/xmldsig-more#eddsa-ed25519"},
              "allowedProviderClasses": {"type": "array", "contains": {"const": "software"}, "items": {"enum": ["software", "hsm", "kms"]}}
            }
          }
        }
      }
    }
  }
}
