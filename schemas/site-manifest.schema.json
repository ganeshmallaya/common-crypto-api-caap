{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/caap/schemas/site-manifest.schema.json",
  "title": "CAAP public website export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "status",
    "sourceCommit",
    "review",
    "targets",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalName", "abbreviation", "interfaceName", "repository"],
      "properties": {
        "canonicalName": {
          "const": "Crypto Agility Algorithm Protocol"
        },
        "abbreviation": {
          "const": "CAAP"
        },
        "interfaceName": {
          "const": "Common Crypto API"
        },
        "repository": {
          "const": "common-crypto-api-caap"
        }
      }
    },
    "status": {
      "enum": ["draft", "reviewed", "published", "withdrawn"]
    },
    "sourceCommit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedBy", "reviewedAt"],
      "properties": {
        "reviewedBy": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/[a-z0-9-/]*/$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentSha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          },
          "contentSha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["reviewed", "published"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "sourceCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "review": {
            "properties": {
              "reviewedBy": {
                "type": "string"
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "files": {
            "items": {
              "properties": {
                "contentSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
