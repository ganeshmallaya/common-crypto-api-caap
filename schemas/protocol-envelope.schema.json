{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/caap/schemas/protocol-envelope.schema.json",
  "title": "CAAP experimental protocol envelope",
  "description": "Research model only; not a normative CAAP binding.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "operation": {
      "enum": [
        "GetCapabilities",
        "ResolvePolicy",
        "GenerateKeyPair",
        "Sign",
        "Verify",
        "Encapsulate",
        "Decapsulate"
      ]
    },
    "algorithmReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "identifier"],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "policyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileVersion"],
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "apiVersion",
        "requestId",
        "operation",
        "intent",
        "input"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "const": "request"
        },
        "apiVersion": {
          "type": "string",
          "const": "0.1.0-experimental"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "intent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$"
        },
        "expectedPolicy": {
          "oneOf": [
            {
              "$ref": "#/$defs/policyReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimumConstraints": {
          "type": "object"
        },
        "input": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "apiVersion",
        "requestId",
        "operation",
        "outcome"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "const": "response"
        },
        "apiVersion": {
          "type": "string",
          "const": "0.1.0-experimental"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "outcome": {
          "enum": ["success", "rejected", "failed"]
        },
        "policy": {
          "oneOf": [
            {
              "$ref": "#/$defs/policyReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm": {
          "oneOf": [
            {
              "$ref": "#/$defs/algorithmReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerRef": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "result": {
          "type": ["object", "null"]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHORIZED",
            "POLICY_NOT_FOUND",
            "POLICY_AMBIGUOUS",
            "POLICY_INACTIVE",
            "CONSTRAINT_MISMATCH",
            "CAPABILITY_MISMATCH",
            "KEY_STATE_INVALID",
            "PROVIDER_UNAVAILABLE",
            "OPERATION_FAILED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
