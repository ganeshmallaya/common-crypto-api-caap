{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganeshmallaya.github.io/common-crypto-api-caap/schemas/protocol-envelope.schema.json",
  "title": "CAAP Common Crypto API request",
  "description": "Experimental request envelope for the implemented artifact-signing 0.2.0-draft HTTP slice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "requestId", "operation", "intent", "minimumConstraints", "input"],
  "properties": {
    "$schema": {"type": "string"},
    "apiVersion": {"const": "0.2.0-draft"},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "operation": {"enum": ["ResolvePolicy", "CreateKey", "Sign", "Verify"]},
    "intent": {"const": "artifact-signing"},
    "expectedPolicy": {"$ref": "#/$defs/policyReference"},
    "minimumConstraints": {"$ref": "#/$defs/minimumConstraints"},
    "input": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "ResolvePolicy"}}, "required": ["operation"]},
      "then": {"properties": {"input": {"type": "object", "maxProperties": 0}}}
    },
    {
      "if": {"properties": {"operation": {"const": "CreateKey"}}, "required": ["operation"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/createKeyInput"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "Sign"}}, "required": ["operation"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/signInput"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "Verify"}}, "required": ["operation"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/verifyInput"}}}
    }
  ],
  "$defs": {
    "policyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileVersion"],
      "properties": {
        "profileId": {"type": "string", "minLength": 1, "maxLength": 128},
        "profileVersion": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "minimumConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"const": "artifact-signing-v0"},
        "providerClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["software", "hsm", "kms"]}
        }
      }
    },
    "canonicalBase64": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}|[A-Za-z0-9+/]{3})?$"
    },
    "keyRef": {"type": "string", "pattern": "^key_[A-Za-z0-9_-]{16,128}$"},
    "createKeyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose"],
      "properties": {"purpose": {"const": "sign"}}
    },
    "signInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyRef", "message"],
      "properties": {
        "keyRef": {"$ref": "#/$defs/keyRef"},
        "message": {"$ref": "#/$defs/canonicalBase64"}
      }
    },
    "verifyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyRef", "message", "signature"],
      "properties": {
        "keyRef": {"$ref": "#/$defs/keyRef"},
        "message": {"$ref": "#/$defs/canonicalBase64"},
        "signature": {"$ref": "#/$defs/canonicalBase64"}
      }
    }
  }
}
